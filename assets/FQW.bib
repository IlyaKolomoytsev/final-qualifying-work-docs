@article{balciPrinciplesSimulationModel1997,
  title = {Principles of Simulation Model Validation, Verification, and Testing},
  author = {Balci, Osman},
  date = {1997},
  journaltitle = {Transactions of The Society for Computer Simulation International},
  volume = {14},
  pages = {3--12},
  url = {https://api.semanticscholar.org/CorpusID:61084265},
  abstract = {Sufficient experience has been gained over the last decade in simulation model validation, verification, and testing (VV\&T) to establish basic principles and its characteristics. This paper presents 15 principles of simulation model VV\&T. These principles help the researchers, practitioners, and manaagers better understand what model VV\&T is all about. They serve to provide the underpinnings for the VV\&T techniques that can be used throughout the life cycle of a simulation study. Understanding and applying these principles is crucially important for the success of a simulation study.}
}

