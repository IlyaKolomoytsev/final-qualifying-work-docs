        "  Message 1:\n" +
        "    Send time:      0 ms\n" +
        "    Receive result: success\n" +
        "    Receive time:   10333 ms\n" +
        "    Sender address:   20-10-00\n" +
        "    Receiver address: 20-10-20\n" +
        "    Payload:        Sender 1 message\n" +
        "    Mean SNR:       243.80\n" +
        "  Message 2:\n" +
        "    Send time:      0 ms\n" +
        "    Receive result: failure\n" +
