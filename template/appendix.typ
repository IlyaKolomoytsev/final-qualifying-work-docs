/// Флаг режима приложений: `true`, когда текущая секция является приложением.
/// -> state
#let appendix-state = state("appendix-state", false)

/// Возвращает русскую букву обозначения приложения по порядковому номеру.
///
/// Список по ГОСТ 7.32: исключены З, Й, О, Ч, Ъ, Ы, Ь.
///
/// - number (int): Порядковый номер приложения, начиная с 1.
/// -> str
#let appendix-letter(number) = {
  // Буквы ГОСТ без запрещённых: З, Й, О, Ч, Ъ, Ы, Ь.
  let letters = (
    "А",
    "Б",
    "В",
    "Г",
    "Д",
    "Е",
    "Ж",
    "И",
    "К",
    "Л",
    "М",
    "Н",
    "П",
    "Р",
    "С",
    "Т",
    "У",
    "Ф",
    "Х",
    "Ц",
    "Ш",
    "Щ",
    "Э",
    "Ю",
    "Я",
  )
  letters.at(number - 1)
}

/// Заменяет первый элемент массива счётчика заголовков буквой приложения.
///
/// - counts (array): Массив счётчиков заголовков; первый элемент — номер приложения.
/// -> array
#let appendix-numbers(counts) = (appendix-letter(counts.first()),) + counts.slice(1)

/// Возвращает текущий счётчик приложений в виде массива с буквой на первом месте.
/// -> array
#let appendix-counts() = appendix-numbers(counter("appendix").get())
